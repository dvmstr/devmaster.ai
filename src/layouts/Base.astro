---
import { Font } from "astro:assets";
import "../styles/global.css";
import { LOCALES, LOCALE_META, DEFAULT_LOCALE, localePath, type Locale } from "../lib/i18n";
import { SITE } from "../lib/site";

interface Props {
  locale: Locale;
  /** Chemin de la page sans préfixe de langue ("/" ou "/legal/"). */
  path: string;
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  noindex?: boolean;
  /** Données structurées schema.org (JSON-LD). */
  jsonLd?: Record<string, unknown>[];
  /** Adresse canonique et variantes de langue (pas pour la page 404). */
  alternates?: boolean;
}

const { locale, path, title, description, ogTitle = title, ogDescription = description, noindex = false, jsonLd = [], alternates = true } = Astro.props;
const meta = LOCALE_META[locale];
const canonical = new URL(localePath(locale, path), SITE.url).href;
const ogImage = new URL(`/og/${locale}.png`, SITE.url).href;
---

<!doctype html>
<html lang={meta.htmlLang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      alternates && (
        <>
          <link rel="canonical" href={canonical} />
          {LOCALES.map((l) => (
            <link rel="alternate" hreflang={LOCALE_META[l].htmlLang} href={new URL(localePath(l, path), SITE.url).href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={new URL(localePath(DEFAULT_LOCALE, path), SITE.url).href} />
        </>
      )
    }
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogTitle} />
    <meta property="og:locale" content={meta.ogLocale} />
    {LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={LOCALE_META[l].ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <Font cssVariable="--font-inter" />
    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class="bg-black font-sans">
    <slot />
  </body>
</html>
