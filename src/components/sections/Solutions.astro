---
import Icon from "../Icon.astro";
import LightSource from "../LightSource.astro";
import Benefits from "./Benefits.astro";
import type { IconName } from "../../lib/icons";

/**
 * « Solutions » : un seul en-tête, puis ce que nous automatisons (le cercle) et ce que ça change (les bénéfices),
 * et un seul bouton — qui reste en bas de section, éclairé par le faisceau du Process.
 */

interface Item {
  id: number;
  title: string;
  tagline: string;
  description: string;
  icon: IconName;
  relatedIds: number[];
  impactStat: string;
}
interface Props {
  solutions: { title: string; subtitle: string; cta: string; combineWith: string; items: Item[] };
  benefits: { icon: IconName; title: string; description: string }[];
}
const { solutions, benefits } = Astro.props;
const byId = new Map(solutions.items.map((i) => [i.id, i]));
---

<section id="solutions" class="relative pt-16 pb-12 sm:pt-24 sm:pb-16">
  <!-- Faisceau d'en-tête tourné vers le hero ; sur mobile, un second sous le bouton de fin de section. -->
  <LightSource direction={180} color="cyan" intensity="high" class="-top-96! -bottom-40 left-1/2 -translate-x-1/2" />
  <LightSource direction={180} color="blue" intensity="medium" class="-bottom-40 left-1/2 -translate-x-1/2 sm:hidden" />

  <div class="relative z-10 mb-6 text-center sm:mb-8">
    <h2 class="mb-3 px-4 text-3xl font-medium text-white sm:mb-4 sm:text-4xl md:text-5xl">{solutions.title}</h2>
    <p class="mx-auto max-w-2xl px-6 text-base text-gray-400 sm:text-lg">{solutions.subtitle}</p>
  </div>

  <!-- Cercle et ses faisceaux (au-dessus sur mobile, de chaque côté sur grand écran). Hauteur fixe : de quoi afficher
       le cercle et une fiche ouverte (amenée en haut), sans grand vide autour. -->
  <div class="relative">
    <LightSource direction={0} color="cyan" intensity="medium" class="-top-47 left-1/2 -translate-x-1/2 sm:hidden" />
    <LightSource direction={270} color="cyan" intensity="medium" class="top-1/2 -left-64 hidden -translate-y-1/2 sm:block" />
    <LightSource direction={90} color="blue" intensity="medium" class="top-1/2 -right-64 hidden -translate-y-1/2 sm:block" />

    <!-- Orbite : les solutions tournent autour d'un noyau ; un clic ouvre la fiche et met en avant les solutions associées. -->
    <div class="relative z-10 flex h-[42rem] w-full flex-col items-center justify-center overflow-hidden bg-transparent md:h-[44rem]" data-orbital>
      <div class="relative flex h-full w-full max-w-4xl items-center justify-center lg:max-w-6xl">
        <div class="orbit absolute flex h-full w-full items-center justify-center" data-orbit>
          <div class="absolute z-10 flex h-16 w-16 animate-pulse items-center justify-center rounded-full bg-linear-to-br from-cyan-400 via-cyan-500 to-teal-400">
            <div class="absolute h-20 w-20 animate-ping rounded-full border border-cyan-400/30 opacity-70"></div>
            <div class="ping-late absolute h-24 w-24 animate-ping rounded-full border border-cyan-400/20 opacity-50"></div>
            <div class="h-8 w-8 rounded-full bg-cyan-100/90 backdrop-blur-md"></div>
          </div>

          <div class="orbit-ring absolute rounded-full border border-white/10 transition-all duration-500" data-ring></div>

          {
            solutions.items.map((item) => (
              <div class="node absolute cursor-pointer" data-node={item.id} data-related={item.relatedIds.join(",")}>
                <div class="halo depth-fade absolute -inset-1 rounded-full" />
                <button type="button" class="node-button block" aria-expanded="false" aria-controls={`solution-${item.id}`}>
                  <span class="node-circle relative flex h-12 w-12 items-center justify-center rounded-full border">
                    <span class="node-sheen absolute inset-0 rounded-full bg-linear-to-br from-cyan-500/10 to-transparent" />
                    <Icon name={item.icon} size={18} class="node-icon relative z-10" />
                  </span>
                  <span class="node-label absolute top-14 left-1/2 max-w-[100px] -translate-x-1/2 overflow-hidden text-[10px] font-light tracking-wide text-ellipsis whitespace-nowrap sm:max-w-none sm:text-xs">
                    {item.title}
                  </span>
                </button>

                <div
                  id={`solution-${item.id}`}
                  class="card absolute top-24 left-1/2 z-[250] w-[90vw] max-w-[20rem] -translate-x-1/2 cursor-default overflow-visible rounded-lg border border-cyan-500/30 bg-black shadow-2xl shadow-cyan-500/20 sm:w-72"
                  hidden
                >
                  <div class="absolute -top-3 left-1/2 h-3 w-px -translate-x-1/2 bg-linear-to-b from-cyan-400/50 to-transparent" />
                  <div class="p-5">
                    <div class="mb-4">
                      <span class="block w-full text-xs font-medium tracking-wide text-cyan-400 uppercase">{item.tagline}</span>
                    </div>
                    <h3 class="mb-3 text-lg font-normal tracking-wide text-white">{item.title}</h3>
                    <p class="text-sm leading-relaxed font-light text-white/70">{item.description}</p>
                    <div class="mt-5 border-t border-white/10 pt-4">
                      <div class="flex items-center gap-2.5">
                        <Icon name="Zap" size={16} class="shrink-0 text-cyan-400" />
                        <span class="impact bg-linear-to-r from-cyan-300 to-teal-300 bg-clip-text text-base font-semibold text-transparent sm:text-lg">
                          {item.impactStat}
                        </span>
                      </div>
                    </div>
                    {item.relatedIds.length > 0 && (
                      <div class="mt-5 border-t border-white/10 pt-4">
                        <h4 class="mb-3 flex items-center gap-1.5 text-[11px] font-light tracking-[0.15em] text-white/50 uppercase">
                          <Icon name="Link" size={11} class="text-cyan-400/60" />
                          {solutions.combineWith}
                        </h4>
                        <div class="flex flex-wrap gap-x-4 gap-y-2">
                          {item.relatedIds.map((rid) => (
                            <button
                              type="button"
                              class="text-xs font-light text-cyan-400/80 underline decoration-cyan-400/30 underline-offset-2 transition-colors duration-200 hover:text-cyan-300 hover:decoration-cyan-300/50"
                              data-open={rid}
                            >
                              {byId.get(rid)?.title}
                            </button>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <Benefits items={benefits} />

  <div class="relative z-10 mt-8 flex justify-center px-4 sm:mt-12 sm:px-6">
    <a href="#cta-final" class="btn-glass-filled group flex w-full max-w-sm items-center justify-center gap-2 sm:w-auto">
      {solutions.cta}
      <Icon name="ArrowRight" size={16} class="transition-transform duration-300 group-hover:translate-x-0.5" />
    </a>
  </div>
</section>

<style>
  .orbit {
    perspective: 1000px;
  }
  .ping-late {
    animation-delay: 0.5s;
  }
  .node {
    will-change: transform;
    transition: z-index 0.7s;
  }
  .orbital-paused .node {
    transition:
      transform 0.7s,
      z-index 0.7s;
  }
  /* Opacité de profondeur : 0,7 s ; couleurs, ombre et échelle : 0,3 s (réglages de l'ancien site). */
  .depth-fade {
    transition: opacity 0.7s;
  }
  .node-circle,
  .node-label {
    transition:
      opacity 0.7s,
      color 0.3s,
      background-color 0.3s,
      background-image 0.3s,
      border-color 0.3s,
      box-shadow 0.3s,
      scale 0.3s;
  }
  .halo {
    left: -20px;
    top: -20px;
    width: 80px;
    height: 80px;
    background: radial-gradient(circle, rgba(6, 182, 212, 0.15) 0%, rgba(6, 182, 212, 0) 70%);
  }
  .node[data-related-active] .halo {
    background: radial-gradient(circle, rgba(6, 182, 212, 0.3) 0%, rgba(6, 182, 212, 0) 70%);
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  .node[data-expanded] .halo {
    background: radial-gradient(circle, rgba(6, 182, 212, 0.4) 0%, rgba(6, 182, 212, 0) 70%);
  }
  /* États du rond : normal, associé à la fiche ouverte, ouvert. */
  .node-circle {
    background: #000;
    border-color: rgb(6 182 212 / 0.4);
  }
  .node-button:hover .node-circle {
    scale: 1.1;
  }
  .node-icon {
    color: var(--color-cyan-400);
  }
  .node-label {
    color: var(--color-gray-400);
  }
  .node[data-related-active] .node-circle {
    background-image: linear-gradient(to bottom right, rgb(6 182 212 / 0.8), rgb(8 145 178 / 0.8), rgb(20 184 166 / 0.8));
    border-color: var(--color-cyan-400);
    box-shadow:
      0 4px 6px -1px rgb(6 182 212 / 0.3),
      0 2px 4px -2px rgb(6 182 212 / 0.3);
  }
  .node[data-expanded] .node-circle {
    background-image: linear-gradient(to bottom right, var(--color-cyan-400), var(--color-cyan-500), var(--color-teal-400));
    border-color: var(--color-cyan-300);
    box-shadow:
      0 10px 15px -3px rgb(6 182 212 / 0.5),
      0 4px 6px -4px rgb(6 182 212 / 0.5);
    scale: 1.25;
  }
  .node[data-related-active] .node-sheen,
  .node[data-expanded] .node-sheen {
    display: none;
  }
  .node[data-related-active] .node-icon,
  .node[data-expanded] .node-icon {
    color: #fff;
  }
  .node[data-expanded] .node-icon {
    width: 20px;
    height: 20px;
  }
  .node[data-related-active] .node-label {
    color: rgb(34 211 238 / 0.9);
  }
  .node[data-expanded] .node-label {
    color: var(--color-cyan-300);
    font-weight: 400;
    scale: 1.1;
  }
  .impact {
    animation: impact-in 0.5s ease-out 0.2s both;
  }
  @keyframes impact-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
</style>

<script>
  // Rotation automatique (6°/s) ; un clic sur une solution arrête la rotation, l'amène en haut du cercle et
  // ouvre sa fiche ; un clic sur le fond referme tout et relance la rotation.
  for (const root of document.querySelectorAll<HTMLElement>("[data-orbital]")) {
    const orbit = root.querySelector<HTMLElement>("[data-orbit]")!;
    const ring = root.querySelector<HTMLElement>("[data-ring]")!;
    const nodes = [...root.querySelectorAll<HTMLElement>("[data-node]")];
    const ids = nodes.map((n) => Number(n.dataset.node));
    const parts = nodes.map((n) => [".halo", ".node-circle", ".node-label"].map((sel) => n.querySelector<HTMLElement>(sel)!) as [HTMLElement, HTMLElement, HTMLElement]);
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let rotation = 0;
    let autoRotate = !reduce;
    let expanded: number | null = null;
    let visible = false;
    let radius = 180;

    const computeRadius = () => {
      const w = window.innerWidth;
      // Sur mobile, le cercle tient dans l'écran (les étiquettes débordaient de l'ancien site).
      radius = w >= 1024 ? 280 : w >= 768 ? 220 : Math.min(180, Math.floor(w / 2 - 52));
      ring.style.width = ring.style.height = `${radius * 2}px`;
    };

    const layout = () => {
      nodes.forEach((node, i) => {
        const angle = ((i / nodes.length) * 360 + rotation) % 360;
        const rad = (angle * Math.PI) / 180;
        const isOpen = expanded === ids[i];
        node.style.transform = `translate(${radius * Math.cos(rad)}px, ${radius * Math.sin(rad)}px)`;
        node.style.zIndex = String(isOpen ? 200 : Math.round(100 + 50 * Math.cos(rad)));
        // Profondeur : les solutions à l'arrière s'estompent (0,4), leur nom reste lisible (0,75 au minimum).
        const depth = isOpen ? 1 : Math.max(0.4, Math.min(1, 0.4 + 0.6 * ((1 + Math.sin(rad)) / 2)));
        const [halo, circle, label] = parts[i]!;
        halo.style.opacity = circle.style.opacity = String(depth);
        label.style.opacity = String(Math.max(0.75, depth));
      });
    };

    const render = () => {
      const related = expanded === null ? [] : (nodes[ids.indexOf(expanded)]?.dataset.related ?? "").split(",").map(Number);
      nodes.forEach((node, i) => {
        const isOpen = expanded === ids[i];
        node.toggleAttribute("data-expanded", isOpen);
        node.toggleAttribute("data-related-active", !isOpen && related.includes(ids[i]!));
        node.querySelector("button")!.setAttribute("aria-expanded", String(isOpen));
        node.querySelector<HTMLElement>(".card")!.hidden = !isOpen;
      });
      root.classList.toggle("orbital-paused", !autoRotate);
      layout();
    };

    const toggle = (id: number) => {
      if (expanded === id) {
        expanded = null;
        autoRotate = !reduce;
      } else {
        expanded = id;
        autoRotate = false;
        rotation = 270 - (ids.indexOf(id) / nodes.length) * 360; // la solution ouverte vient en haut
      }
      render();
    };

    nodes.forEach((node, i) => {
      node.addEventListener("click", (e) => {
        const open = (e.target as HTMLElement).closest<HTMLElement>("[data-open]");
        e.stopPropagation();
        toggle(open ? Number(open.dataset.open) : ids[i]!);
      });
    });
    root.addEventListener("click", (e) => {
      if (e.target === root || e.target === orbit) {
        expanded = null;
        autoRotate = !reduce;
        render();
      }
    });

    let last = performance.now();
    const frame = (now: number) => {
      if (autoRotate && visible) {
        rotation = (rotation + ((now - last) / 1000) * 6) % 360;
        layout();
      }
      last = now;
      requestAnimationFrame(frame);
    };
    // La rotation ne tourne que lorsque le cercle est à l'écran.
    new IntersectionObserver(([entry]) => (visible = !!entry?.isIntersecting)).observe(root);
    window.addEventListener("resize", () => {
      computeRadius();
      layout();
    });
    computeRadius();
    render();
    requestAnimationFrame(frame);
  }
</script>
