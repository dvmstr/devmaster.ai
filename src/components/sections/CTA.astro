---
import Icon from "../Icon.astro";
import LightSource from "../LightSource.astro";
import { SITE } from "../../lib/site";

interface Props {
  cta: { title: string; subtitle: string; whatsapp: string; disclaimer: string };
  whatsappLabel: string;
}
const { cta, whatsappLabel } = Astro.props;
---

<section id="cta-final" class="relative py-20 sm:py-32">
  <LightSource direction={180} color="cyan" intensity="high" class="-bottom-40 left-1/2 -translate-x-1/2" />

  <div class="relative z-10 mx-auto max-w-4xl px-4 sm:px-6">
    <div class="rounded-2xl border border-white/20 bg-linear-to-br from-white/10 to-white/5 p-6 text-center backdrop-blur-xl sm:p-10 md:p-12">
      <h2 class="mb-3 px-2 text-2xl font-medium text-white sm:mb-4 sm:text-3xl md:text-5xl">{cta.title}</h2>
      <p class="mx-auto mb-8 max-w-2xl px-2 text-base text-gray-300 sm:mb-10 sm:text-lg md:text-xl">{cta.subtitle}</p>

      <div class="mb-5 flex flex-col items-center justify-center gap-3 sm:mb-6 sm:flex-row">
        <a
          href={SITE.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-glass-filled group flex w-full items-center justify-center gap-2 sm:w-auto"
          aria-label={`${whatsappLabel} — ${cta.whatsapp}`}
        >
          <Icon name="MessageCircle" size={16} />
          <span class="text-sm sm:text-base">{cta.whatsapp}</span>
        </a>
      </div>

      <p class="px-2 text-[11px] text-gray-400 sm:text-xs">{cta.disclaimer}</p>
    </div>
  </div>
</section>
