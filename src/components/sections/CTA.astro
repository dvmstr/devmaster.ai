---
import Icon from "../Icon.astro";
import LightSource from "../LightSource.astro";
import FAQ from "./FAQ.astro";
import { SITE } from "../../lib/site";

/**
 * Contact (#cta-final, cible de tous les boutons « audit ») : un seul panneau sous un faisceau — à gauche l'appel à
 * l'action (WhatsApp, e-mail, garanties), à droite la FAQ. Sur mobile, l'appel à l'action d'abord.
 */
interface Props {
  cta: { title: string; subtitle: string; whatsapp: string; email: string; points: string[] };
  faq: { title: string; items: { question: string; answer: string }[] };
  whatsappLabel: string;
}
const { cta, faq, whatsappLabel } = Astro.props;
---

<section id="cta-final" class="relative pt-16 pb-12 sm:pt-24 sm:pb-16">
  <!-- Ligne du faisceau entre « Rejoignez-les maintenant » et le panneau : l'arrière éclaire le bouton, le cône le panneau. -->
  <LightSource direction={0} color="cyan" intensity="medium" class="-top-44 left-1/2 -translate-x-1/2" />

  <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6">
    <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03] backdrop-blur-xl">
      <div class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-cyan-400/70 to-transparent" aria-hidden="true"></div>

      <div class="grid lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]">
        <!-- Appel à l'action : promesse, garanties, puis boutons — fixes quand une réponse de la FAQ s'ouvre à côté. -->
        <div class="flex flex-col gap-10 p-6 sm:p-10 lg:p-12">
          <div>
            <h2 class="mb-4 text-3xl font-medium tracking-tight text-balance text-white sm:text-4xl lg:text-5xl">{cta.title}</h2>
            <p class="max-w-md text-base leading-relaxed text-gray-400 sm:text-lg">{cta.subtitle}</p>
            <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 lg:flex-col lg:gap-2.5">
              {
                cta.points.map((point) => (
                  <li class="flex items-center gap-2 text-sm text-gray-300">
                    <Icon name="Check" size={15} class="text-cyan-400" />
                    {point}
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
            <a
              href={SITE.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-full bg-cyan-400 px-6 py-3 text-sm font-medium text-black shadow-[0_0_24px_rgb(34_211_238/0.35)] transition-all duration-300 ease-out hover:bg-cyan-300 hover:shadow-[0_0_36px_rgb(34_211_238/0.5)] active:scale-95"
              aria-label={`${whatsappLabel} — ${cta.whatsapp}`}
            >
              <Icon name="MessageCircle" size={16} />
              {cta.whatsapp}
            </a>
            <a href={`mailto:${SITE.email}`} class="btn-glass-outline inline-flex items-center justify-center gap-2 px-6 py-3 text-sm">
              <Icon name="Mail" size={16} />
              {cta.email}
            </a>
          </div>
        </div>

        <div class="border-t border-white/10 p-6 sm:p-10 lg:border-t-0 lg:border-l lg:p-12">
          <FAQ faq={faq} />
        </div>
      </div>
    </div>
  </div>
</section>
