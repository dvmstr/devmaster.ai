---
import Icon from "../Icon.astro";
import LightSource from "../LightSource.astro";
import type { IconName } from "../../lib/icons";

/**
 * « Offre » (#offer) : les deux façons de travailler (abonnement recommandé, ou one-shot), l'audit qui précède,
 * les étoiles, puis l'espace client Devmaster OS. Les prix viennent du contenu (src/content/site/<langue>.json),
 * alignés sur ceux du portail (devmaster-portal, src/config/offer.ts).
 */
interface Plan {
  name: string;
  price: string;
  period: string;
  tagline: string;
  description: string;
  features: string[];
  recommended: boolean;
}
interface Props {
  offer: {
    title: string;
    subtitle: string;
    recommended: string;
    plans: Plan[];
    auditNote: string;
    cta: string;
    starsTitle: string;
    starsText: string;
    starsItems: string[];
    osTitle: string;
    osSubtitle: string;
    osItems: { icon: IconName; title: string; description: string }[];
  };
}
const { offer } = Astro.props;
---

<section id="offer" class="relative pt-12 pb-12 sm:pt-20 sm:pb-16">
  <LightSource direction={0} color="cyan" intensity="medium" class="-top-52 left-1/2 -translate-x-1/2" />

  <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto mb-10 max-w-3xl text-center sm:mb-14">
      <h2 class="mb-3 text-3xl font-medium text-balance text-white sm:mb-4 sm:text-4xl md:text-5xl">{offer.title}</h2>
      <p class="text-sm text-gray-400 sm:text-base md:text-lg">{offer.subtitle}</p>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {
        offer.plans.map((plan) => (
          <article
            class:list={[
              "relative flex flex-col gap-5 overflow-hidden rounded-3xl border p-6 backdrop-blur-xl sm:p-8",
              plan.recommended ? "border-cyan-400/50 bg-cyan-400/[0.06] shadow-[0_0_40px_rgb(34_211_238/0.12)]" : "border-white/10 bg-white/[0.03]",
            ]}
          >
            {plan.recommended && <div class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-cyan-400/80 to-transparent" aria-hidden="true" />}
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-xl font-medium text-white sm:text-2xl">{plan.name}</h3>
              {plan.recommended && <span class="rounded-full bg-cyan-400/15 px-3 py-1 text-xs text-cyan-300">{offer.recommended}</span>}
            </div>
            <div>
              <p class="flex flex-wrap items-baseline gap-x-2">
                <span class="text-4xl font-medium text-white sm:text-5xl">{plan.price}</span>
                <span class="text-sm text-gray-400">{plan.period}</span>
              </p>
              <p class="mt-2 text-sm text-cyan-300">{plan.tagline}</p>
            </div>
            <p class="text-sm leading-relaxed text-gray-300 sm:text-base">{plan.description}</p>
            <ul class="mt-auto space-y-2.5">
              {plan.features.map((f) => (
                <li class="flex items-start gap-2.5 text-sm text-gray-300">
                  <Icon name="Check" size={16} class="mt-0.5 shrink-0 text-cyan-400" />
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="mt-6 flex flex-col items-center gap-4 text-center">
      <p class="max-w-2xl text-sm text-gray-300 sm:text-base">{offer.auditNote}</p>
      <a href="#cta-final" class="btn-glass-filled group inline-flex items-center gap-2 px-6 py-3 text-sm">
        {offer.cta}
        <Icon name="ArrowRight" size={16} class="transition-transform group-hover:translate-x-0.5" />
      </a>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-start">
      <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6 sm:p-8">
        <h3 class="mb-3 flex items-center gap-2 text-xl font-medium text-white">
          <span class="text-cyan-300" aria-hidden="true">★</span>
          {offer.starsTitle}
        </h3>
        <p class="mb-5 text-sm leading-relaxed text-gray-300 sm:text-base">{offer.starsText}</p>
        <ul class="space-y-2.5">
          {
            offer.starsItems.map((s) => (
              <li class="flex items-start gap-2.5 text-sm text-gray-300">
                <Icon name="Check" size={16} class="mt-0.5 shrink-0 text-cyan-400" />
                <span>{s}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3 class="mb-2 text-xl font-medium text-white sm:text-2xl">{offer.osTitle}</h3>
        <p class="mb-5 text-sm text-gray-400 sm:text-base">{offer.osSubtitle}</p>
        <ul class="grid gap-4 sm:grid-cols-2">
          {
            offer.osItems.map((item) => (
              <li class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
                <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-cyan-500/20">
                  <Icon name={item.icon} size={20} class="text-cyan-400" />
                </div>
                <h4 class="mb-1.5 text-base font-medium text-white">{item.title}</h4>
                <p class="text-sm leading-relaxed text-gray-400">{item.description}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
