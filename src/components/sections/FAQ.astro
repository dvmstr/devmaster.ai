---
/**
 * FAQ : moitié droite du panneau de contact (section #cta-final). Accordéon natif, une seule réponse ouverte à la fois
 * (attribut name), toutes fermées au départ, sans script. L'ancre #faq reste valable.
 */
interface Props {
  faq: { title: string; items: { question: string; answer: string }[] };
}
const { faq } = Astro.props;
---

<div id="faq" class="scroll-mt-28">
  <h3 class="mb-2 text-[11px] font-medium tracking-[0.14em] text-cyan-400 uppercase">{faq.title}</h3>
  <div class="divide-y divide-white/10">
    {
      faq.items.map((item) => (
        <details name="faq" class="faq-item">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-4 text-left">
            <span class="question text-sm leading-6 sm:text-[15px]">{item.question}</span>
            <span class="plus relative mt-1.5 size-3.5 shrink-0" aria-hidden="true" />
          </summary>
          <p class="answer pr-8 pb-5 text-sm leading-relaxed text-gray-400">{item.answer}</p>
        </details>
      ))
    }
  </div>
</div>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .question {
    color: var(--color-gray-300);
    transition: color 0.2s;
  }
  .faq-item:hover .question,
  .faq-item[open] .question {
    color: #fff;
  }
  /* « + » dessiné en CSS : il pivote en « × » cyan quand la réponse est ouverte. */
  .plus {
    color: var(--color-gray-400);
    transition:
      rotate 0.25s ease-out,
      color 0.2s;
  }
  .plus::before,
  .plus::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    border-radius: 9999px;
    background: currentColor;
  }
  .plus::before {
    width: 100%;
    height: 1.5px;
  }
  .plus::after {
    width: 1.5px;
    height: 100%;
  }
  .faq-item:hover .plus {
    color: #fff;
  }
  .faq-item[open] .plus {
    rotate: 45deg;
    color: var(--color-cyan-400);
  }
  /* Ouverture/fermeture animées (0,25 s) dans les navigateurs qui le permettent ; instantanées ailleurs. */
  @supports (interpolate-size: allow-keywords) {
    .faq-item {
      interpolate-size: allow-keywords;
    }
    .faq-item::details-content {
      block-size: 0;
      opacity: 0;
      overflow: hidden;
      transition:
        block-size 0.25s ease-in,
        opacity 0.25s ease-in,
        content-visibility 0.25s allow-discrete;
    }
    .faq-item[open]::details-content {
      block-size: auto;
      opacity: 1;
      transition-timing-function: ease-out;
    }
  }
</style>
