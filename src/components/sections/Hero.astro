---
import Icon from "../Icon.astro";
import LogoCarousel from "../LogoCarousel.astro";

interface Props {
  label: string;
  hero: { badge: string; title: string; description: string; ctaPrimary: string; ctaSecondary: string; logos: string[] };
}
const { label, hero } = Astro.props;
---

<section class="relative flex h-svh min-h-svh flex-col justify-between pt-16 sm:pt-20" aria-label={label}>
  <div class="relative z-10 mx-auto flex max-w-5xl flex-1 flex-col justify-center px-4 text-center sm:px-6">
    <div class="mb-6 flex justify-center">
      <div class="relative inline-flex items-center gap-2 overflow-hidden rounded-full px-3 py-1.5">
        <div class="animate-border-color-flow absolute inset-0 rounded-full border"></div>
        <div class="animate-shimmer-slow absolute inset-0 rounded-full bg-linear-to-r from-transparent via-cyan-500/30 to-transparent"></div>
        <span class="relative z-10 text-xs font-light text-gray-300">{hero.badge}</span>
      </div>
    </div>

    <h1 class="mb-4 px-2 text-3xl leading-tight font-medium text-white sm:mb-5 sm:text-4xl sm:leading-10 md:text-6xl md:leading-none lg:text-7xl">
      {hero.title}
    </h1>

    <p class="mx-auto mb-8 max-w-2xl px-2 text-base leading-relaxed text-gray-400 sm:mb-10 sm:text-lg sm:leading-7 md:text-xl">
      {hero.description}
    </p>

    <div class="flex flex-col items-center justify-center gap-3 px-4 sm:flex-row">
      <a href="#cta-final" class="btn-glass-filled group flex w-full items-center justify-center gap-2 sm:w-auto">
        {hero.ctaPrimary}
        <Icon name="ArrowRight" size={16} class="transition-transform duration-300 group-hover:translate-x-0.5" />
      </a>
      <a href="#process" class="btn-glass-outline flex w-full items-center justify-center sm:w-auto">
        {hero.ctaSecondary}
      </a>
    </div>
  </div>

  <div class="relative z-10 pb-6 sm:pb-8">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <LogoCarousel logos={hero.logos} />
    </div>
  </div>
</section>
