---
import { Picture } from "astro:assets";
import Icon from "../Icon.astro";
import LightSource from "../LightSource.astro";
import type { IconName } from "../../lib/icons";
import type { Locale } from "../../lib/i18n";
import { SITE } from "../../lib/site";
import { showcaseDemos, SOLUTION_KEYS } from "../../lib/demos";

/**
 * « Démos interactives » (début de la section « Résultats ») : les applications construites pour des entreprises fictives, une par secteur.
 * Le titre de chaque démo dit ce qu'est l'application (« CRM immobilier »), jamais le nom de l'entreprise fictive.
 * Données : le portail client, seule source (quelles démos, ordre, nom, secteur, présentation, solutions, visuel —
 * lus à la construction : src/lib/demos.ts). Les visuels sont téléchargés et optimisés au build. Une démo par ligne, toutes sur le même modèle : visuel à gauche et texte à droite à partir de 1280 px, visuel au-dessus du texte en dessous. Les démos sont privées : le bouton
 * demande une visite guidée sur WhatsApp.
 */
interface Props {
  locale: Locale;
  demos: {
    title: string;
    subtitle: string;
    fictional: string;
    cta: string;
    message: string;
    privateNote: string;
    clientArea: string;
  };
  /** Titres des solutions, dans l'ordre du site (emails, leads, chatbots, crm, social, documents, reporting, recruitment). */
  solutionTitles: string[];
  solutionIcons: IconName[];
}
const { locale, demos: t, solutionTitles, solutionIcons } = Astro.props;

const demos = await showcaseDemos();
const whatsapp = (name: string) => `${SITE.whatsappUrl}?text=${encodeURIComponent(t.message.replace("{name}", name))}`;
---

<div id="demos" class="relative pt-16 pb-14 sm:pt-24 sm:pb-20">
  <!-- Ligne du faisceau à la jonction avec le Process : le cône éclaire le titre, la lueur arrière la fin de la frise. -->
  <LightSource direction={0} color="cyan" intensity="medium" class="-top-48 left-1/2 -translate-x-1/2" />

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6">
    <div class="mx-auto mb-10 max-w-3xl text-center sm:mb-14">
      <h2 class="mb-3 px-2 text-3xl font-medium text-white sm:mb-4 sm:text-4xl md:text-5xl">{t.title}</h2>
      <p class="mx-auto max-w-2xl px-2 text-base text-gray-400 sm:text-lg">{t.subtitle}</p>
    </div>

    <ul class="grid gap-8 lg:gap-10">
      {
        demos.map((d, index) => {
          const chips = d.solutions.map((key) => SOLUTION_KEYS.indexOf(key)).slice(0, 3);
          return (
            <li class="group flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-white/[0.04] transition-colors duration-300 hover:border-cyan-500/40 hover:bg-white/[0.06] xl:flex-row">
              <div class="relative overflow-hidden border-b border-white/10 bg-white/5 xl:w-[58%] xl:shrink-0 xl:border-r xl:border-b-0">
                {d.image && (
                  <Picture
                    src={d.image}
                    inferSize
                    alt={d.industry[locale] ? `${d.name[locale]} — ${d.industry[locale]}` : d.name[locale]}
                    widths={[640, 960, 1280, 1600]}
                    sizes="(min-width: 1280px) 715px, 100vw"
                    formats={["avif", "webp"]}
                    fallbackFormat="jpg"
                    class="aspect-[16/10] w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.02] xl:h-full"
                    loading={index < 2 ? "eager" : "lazy"}
                    decoding="async"
                  />
                )}
                <span class="absolute top-3 left-3 rounded-full border border-white/15 bg-black/70 px-2.5 py-1 text-[11px] font-medium text-gray-200">{t.fictional}</span>
              </div>
              <div class="flex flex-1 flex-col p-6 sm:p-8 lg:p-10 xl:justify-center xl:p-12">
                {d.industry[locale] && <p class="mb-3 text-[11px] font-medium tracking-[0.12em] text-cyan-400 uppercase">{d.industry[locale]}</p>}
                <h3 class="mb-4 text-2xl font-medium text-white sm:text-3xl">{d.name[locale]}</h3>
                <p class="mb-6 text-base leading-relaxed text-gray-400">{d.summary[locale]}</p>
                <ul class="mb-7 flex flex-wrap gap-2">
                  {chips.map((i) => (
                    <li class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-xs text-gray-300">
                      <Icon name={solutionIcons[i] ?? "Zap"} size={12} class="text-cyan-400" />
                      {solutionTitles[i]}
                    </li>
                  ))}
                </ul>
                <a
                  href={whatsapp(d.name[locale])}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-auto inline-flex items-center gap-2 self-start text-sm font-medium text-cyan-300 transition-colors hover:text-cyan-200 xl:mt-0"
                >
                  {t.cta}
                  <Icon name="ArrowRight" size={14} class="transition-transform duration-300 group-hover:translate-x-0.5" />
                </a>
              </div>
            </li>
          );
        })
      }
    </ul>

    <div class="mt-10 flex flex-col items-center gap-4 text-center sm:mt-14">
      <p class="max-w-2xl px-2 text-sm text-gray-400">{t.privateNote}</p>
      <a href={SITE.portalUrl} class="btn-glass-outline group flex items-center justify-center gap-2">
        <Icon name="LogIn" size={16} />
        {t.clientArea}
      </a>
    </div>
  </div>
</div>
