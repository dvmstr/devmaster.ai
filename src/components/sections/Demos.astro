---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "../Icon.astro";
import LightSource from "../LightSource.astro";
import type { IconName } from "../../lib/icons";
import type { Locale } from "../../lib/i18n";
import { SITE } from "../../lib/site";
import demos from "../../data/demos.json";

/**
 * « Démos interactives » : les applications construites pour des entreprises fictives, une par secteur.
 * Données : src/data/demos.json + cartes src/assets/demos/<slug>.jpg (générés par le script site-demos.py depuis
 * le catalogue de chaque démo). Les démos sont privées : le bouton demande une visite guidée sur WhatsApp.
 */
interface Props {
  locale: Locale;
  demos: {
    title: string;
    subtitle: string;
    badge: string;
    fictional: string;
    cta: string;
    message: string;
    privateNote: string;
    clientArea: string;
  };
  /** Titres des solutions, dans l'ordre du site (emails, leads, chatbots, crm, social, documents, reporting, recruitment). */
  solutionTitles: string[];
  solutionIcons: IconName[];
}
const { locale, demos: t, solutionTitles, solutionIcons } = Astro.props;

const SOLUTION_KEYS = ["emails", "leads", "chatbots", "crm", "social", "documents", "reporting", "recruitment"] as const;
const cards = import.meta.glob<{ default: ImageMetadata }>("../../assets/demos/*.jpg", { eager: true });
const imageOf = (slug: string) => cards[`../../assets/demos/${slug}.jpg`]?.default;
const whatsapp = (name: string) => `${SITE.whatsappUrl}?text=${encodeURIComponent(t.message.replace("{name}", name))}`;
---

<section id="demos" class="relative py-16 sm:py-24">
  <LightSource direction={0} color="cyan" intensity="medium" class="-top-20 left-1/2 -translate-x-1/2" />

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6">
    <div class="mx-auto mb-10 max-w-3xl text-center sm:mb-14">
      <span class="mb-4 inline-flex items-center gap-2 rounded-full border border-cyan-500/30 bg-cyan-500/10 px-3 py-1 text-xs font-medium tracking-wide text-cyan-300">
        <Icon name="Zap" size={12} />
        {t.badge}
      </span>
      <h2 class="mb-3 px-2 text-3xl font-medium text-white sm:mb-4 sm:text-4xl md:text-5xl">{t.title}</h2>
      <p class="mx-auto max-w-2xl px-2 text-base text-gray-400 sm:text-lg">{t.subtitle}</p>
    </div>

    <ul class="grid gap-5 sm:gap-6 md:grid-cols-2 xl:grid-cols-3">
      {
        demos.map((d) => {
          const image = imageOf(d.slug);
          const chips = d.solutions
            .map((key) => SOLUTION_KEYS.indexOf(key as (typeof SOLUTION_KEYS)[number]))
            .filter((i) => i >= 0)
            .slice(0, 3);
          return (
            <li class="group flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04] transition-colors duration-300 hover:border-cyan-500/40 hover:bg-white/[0.06]">
              <div class="relative overflow-hidden border-b border-white/10 bg-white/5">
                {image && (
                  <Picture
                    src={image}
                    alt={`${d.name} — ${d.industry[locale]}`}
                    widths={[400, 600, 800]}
                    sizes="(min-width: 1280px) 400px, (min-width: 768px) 50vw, 100vw"
                    formats={["avif", "webp"]}
                    class="aspect-[16/10] w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.02]"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <span class="absolute top-3 left-3 rounded-full border border-white/15 bg-black/70 px-2.5 py-1 text-[11px] font-medium text-gray-200">
                  {t.fictional}
                </span>
              </div>
              <div class="flex flex-1 flex-col p-5 sm:p-6">
                <p class="mb-2 text-[11px] font-medium tracking-[0.12em] text-cyan-400 uppercase">{d.industry[locale]}</p>
                <h3 class="mb-2 flex flex-wrap items-baseline gap-x-2 text-lg font-medium text-white">
                  {d.name}
                  {d.zhName && <span class="text-sm font-normal text-gray-500">{d.zhName}</span>}
                </h3>
                <p class="mb-5 text-sm leading-relaxed text-gray-400">{d.summary[locale]}</p>
                <ul class="mb-6 flex flex-wrap gap-2">
                  {chips.map((i) => (
                    <li class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-xs text-gray-300">
                      <Icon name={solutionIcons[i] ?? "Zap"} size={12} class="text-cyan-400" />
                      {solutionTitles[i]}
                    </li>
                  ))}
                </ul>
                <a
                  href={whatsapp(d.name)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-auto inline-flex items-center gap-2 self-start text-sm font-medium text-cyan-300 transition-colors hover:text-cyan-200"
                >
                  {t.cta}
                  <Icon name="ArrowRight" size={14} class="transition-transform duration-300 group-hover:translate-x-0.5" />
                </a>
              </div>
            </li>
          );
        })
      }
    </ul>

    <div class="mt-10 flex flex-col items-center gap-4 text-center sm:mt-14">
      <p class="max-w-2xl px-2 text-sm text-gray-400">{t.privateNote}</p>
      <a href={SITE.portalUrl} class="btn-glass-outline group flex items-center justify-center gap-2">
        <Icon name="LogIn" size={16} />
        {t.clientArea}
      </a>
    </div>
  </div>
</section>
