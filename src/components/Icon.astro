---
import { ICONS, type IconName, type IconNode } from "../lib/icons";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 24, class: className } = Astro.props;
const kebab = name.replace(/([a-z0-9])([A-Z])/g, "$1-$2").toLowerCase();
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={["lucide", `lucide-${kebab}`, className]}
  aria-hidden="true"
>
  {(ICONS[name] as IconNode).map(([Tag, attrs]) => <Tag {...attrs} />)}
</svg>
