---
import Icon from "./Icon.astro";
import { LOCALES, LOCALE_META, localePath, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  /** Chemin courant sans préfixe de langue : on reste sur la même page en changeant de langue. */
  path: string;
  label: string;
  /** « minimal » : bouton + menu (barre du haut) ; « inline » : trois liens avec drapeaux (pied de page). */
  variant?: "minimal" | "inline";
}
const { locale, path, label, variant = "minimal" } = Astro.props;
const links = LOCALES.map((l) => ({ locale: l, href: localePath(l, path), ...LOCALE_META[l], active: l === locale }));
---

{
  variant === "inline" ? (
    <nav class="flex items-center gap-1" aria-label={label}>
      {links.map((l) => (
        <a
          href={l.href}
          hreflang={l.htmlLang}
          lang={l.htmlLang}
          aria-current={l.active ? "page" : undefined}
          class:list={[
            "rounded-md px-2 py-1 text-sm font-medium transition-all duration-200",
            l.active ? "border border-cyan-500/50 bg-cyan-500/20 text-cyan-400" : "text-gray-400 hover:bg-white/10 hover:text-white",
          ]}
        >
          <span class="mr-1" aria-hidden="true">{l.flag}</span>
          <span>{l.code}</span>
        </a>
      ))}
    </nav>
  ) : (
    <div class="relative" data-lang>
      <button
        type="button"
        class="flex items-center gap-1 rounded-md px-2 py-1 text-sm text-gray-300 transition-colors hover:bg-white/10 hover:text-white"
        aria-expanded="false"
        aria-haspopup="true"
        aria-controls="lang-menu"
        data-lang-toggle
      >
        <Icon name="Globe" size={14} />
        <span class="sr-only">{label}</span>
        <span>{LOCALE_META[locale].code}</span>
      </button>
      <ul
        id="lang-menu"
        class="lang-menu absolute top-full right-0 z-50 mt-1 min-w-[100px] rounded-lg border border-white/10 bg-black/90 py-1 shadow-xl backdrop-blur-md"
        data-lang-menu
      >
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              hreflang={l.htmlLang}
              lang={l.htmlLang}
              aria-current={l.active ? "page" : undefined}
              class:list={[
                "block w-full px-3 py-1.5 text-left text-sm transition-colors",
                l.active ? "bg-cyan-500/10 text-cyan-400" : "text-gray-300 hover:bg-white/10 hover:text-white",
              ]}
            >
              {l.code}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  /* Ouverture : fondu + glissement de 5 px en 0,15 s, comme l'ancien menu. Fermé, il n'est ni visible ni focusable. */
  .lang-menu {
    opacity: 0;
    translate: 0 -5px;
    visibility: hidden;
    transition:
      opacity 0.15s ease,
      translate 0.15s ease,
      visibility 0s linear 0.15s;
  }
  [data-lang][data-open] .lang-menu {
    opacity: 1;
    translate: 0 0;
    visibility: visible;
    transition:
      opacity 0.15s ease,
      translate 0.15s ease;
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-lang]")) {
    const toggle = root.querySelector<HTMLButtonElement>("[data-lang-toggle]")!;
    const setOpen = (open: boolean) => {
      root.toggleAttribute("data-open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };
    toggle.addEventListener("click", () => setOpen(!root.hasAttribute("data-open")));
    document.addEventListener("mousedown", (e) => {
      if (!root.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && root.hasAttribute("data-open")) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
